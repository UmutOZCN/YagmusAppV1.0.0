{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "buildCommand": "cd backend && npm install",
    "startCommand": "cd backend && npm start",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  },
  "env": {
    "NODE_ENV": "production"
  }
}

